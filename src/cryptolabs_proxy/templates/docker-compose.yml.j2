version: '3.8'

services:
  cryptolabs-proxy:
    image: {{ proxy_image }}
    container_name: cryptolabs-proxy
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - ./nginx.conf:/etc/nginx/nginx.conf:ro
      - ./ssl:/etc/nginx/ssl:ro
      - ./services.yaml:/app/services.yaml:ro
      - fleet-auth-data:/data/auth
      {% if release_selection_dir %}
      - {{ (release_selection_dir + ':/etc/cryptolabs/releases:ro') | tojson }}
      {% endif %}
      {% if use_letsencrypt %}
      - ./certbot/conf:/etc/letsencrypt:ro
      - ./certbot/www:/var/www/certbot:ro
      {% endif %}
    environment:
      - DOCKER_HOST=unix:///var/run/docker.sock
      {% if release_selection_dir %}
      - RELEASE_SELECTION_REQUIRED=true
      {% endif %}
    networks:
      - cryptolabs
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost/api/health"]
      interval: 30s
      timeout: 10s
      retries: 3
    labels:
      com.centurylinklabs.watchtower.enable: "{{ 'false' if release_selection_dir else 'true' }}"
      {% if release_selection_dir %}
      io.cryptolabs.update.reference: {{ proxy_image }}
      io.cryptolabs.update.origin: {{ proxy_origin }}
      {% endif %}

  # Cryptolabs Watchtower - auto-updates cryptolabs-proxy (primary) and other labeled containers
  cryptolabs-watchtower:
    image: containrrr/watchtower
    container_name: cryptolabs-watchtower
    restart: unless-stopped
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
    environment:
      - WATCHTOWER_CLEANUP=true
      - WATCHTOWER_POLL_INTERVAL=300
      - WATCHTOWER_LABEL_ENABLE=true
      - WATCHTOWER_INCLUDE_STOPPED=true
      - WATCHTOWER_ROLLING_RESTART=true
    networks:
      - cryptolabs
    labels:
      com.centurylinklabs.watchtower.enable: "true"

networks:
  cryptolabs:
    name: cryptolabs
    driver: bridge

volumes:
  fleet-auth-data:
    name: fleet-auth-data
